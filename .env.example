# Database
POSTGRES_USER=super_agent
POSTGRES_PASSWORD=super_agent
POSTGRES_DB=super_agent
DATABASE_URL=postgresql+asyncpg://super_agent:super_agent@postgres:5432/super_agent

# Redis
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND=redis://redis:6379/1

# Qdrant
QDRANT_URL=http://qdrant:6333

# MinIO / Object storage
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=super-agent

# OPA
OPA_URL=http://opa:8181

# Model providers / agent SDKs
OPENAI_API_KEY=changeme
ANTHROPIC_API_KEY=changeme
COHERE_API_KEY=changeme
MODEL_PROVIDER=openai

# MCP / Agents SDK
MCP_SERVER_URL=changeme
AGENTS_API_KEY=changeme
